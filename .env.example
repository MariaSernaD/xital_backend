# Plantilla de variables de entorno del backend.
# Copiar a .env y rellenar. El .env real nunca se sube a git.

# Entorno de ejecución: development | production
NODE_ENV=development

# Puerto local de la API. En Render lo inyecta la plataforma, no se configura a mano.
PORT=

# Cadena de conexión de MongoDB. OBLIGATORIA.
MONGO_URL=

# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Secretos de firma de los JWT. OBLIGATORIAS.
JWT_SECRET=
JWT_REFRESH_TOKEN=

# Reservadas: hoy el código no las lee. Las expiraciones están fijas en
# src/controllers/authController.js ("1h" el token, "7d" el refresh).
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Orígenes autorizados por CORS, separados por comas y sin barra final. OBLIGATORIA.
# Local: http://localhost:5173
# Producción: https://URL-DEL-FRONTEND
# Varios: http://localhost:5173,http://localhost:4173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Reservada: ningún módulo la consume todavía. No hay redirecciones, correos ni callbacks.
FRONTEND_URL=http://localhost:5173
